; Under extensional equality, a call that reaches itself on the same arguments never returns, and
; fails: a function that diverges on an input differs there from one that returns, and agrees with
; one that fails
(set-option :function-equality extensional)
(set-option :assume-checked false)
(set-option :check-models true)
(define-fun-rec loop ((x Int)) Int (loop x))
(define-funs-rec ((ping ((x Int)) Int) (pong ((x Int)) Int)) ((pong x) (ping x)))
(push 1)
(set-info :status sat)
(assert (not (= (lambda ((x Int)) (loop x)) (lambda ((x Int)) 0))))
(check-sat)
(pop 1)
(push 1)
(set-info :status unsat)
(assert (not (= (lambda ((x Int)) (loop x)) (lambda ((x Int)) (div x 0)))))
(check-sat)
(pop 1)
(push 1)
(set-info :status unsat)
(assert (not (= (lambda ((x Int)) (ping x)) (lambda ((x Int)) (loop x)))))
(check-sat)
(pop 1)
(push 1)
(set-info :status sat)
(declare-const f (-> Int Int))
(assert (not (= f (lambda ((x Int)) (loop x)))))
(check-sat)
(pop 1)
(push 1)
; a function equal to one that diverges fails wherever it is applied
(set-info :status unsat)
(declare-const g (-> Int Int))
(assert (= g (lambda ((x Int)) (pong x))))
(assert (= (@ g 1) 1))
(check-sat)
(pop 1)
