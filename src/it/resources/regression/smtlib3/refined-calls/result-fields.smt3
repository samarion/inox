; The refinements of the fields of a result: a recursive function's result is typed by its
; return type (which proves them by induction), and the results of other functions by a shallow
; contract and by their bodies, once their calls are unfolded
(set-info :status unsat)
(set-option :timeout 10)
(declare-datatypes ((Pos 0)) (((Pos (x (! Int :var v :restrict (> v 0)))))))
(declare-datatypes ((Wrap 0)) (((Wrap (p Pos)))))
(define-fun-rec pos ((n Int)) Pos (ite (<= n 0) (Pos 1) (pos (- n 1))))
(define-fun wrap ((n Int)) Wrap (Wrap (pos n)))
(declare-const n Int)
(assert (<= (x (pos n)) 0))
(check-sat)
(set-info :status unsat)
(set-option :timeout 10)
(declare-const m Int)
(assert (<= (x (p (wrap m))) 0))
(check-sat)
